# Copy to .env.local and replace with local/development credentials.
# Never commit .env.local or real provider credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/susuapp?sslmode=require"
ARKESEL_API_KEY="replace-with-arkesel-api-key"
PAYSTACK_SECRET_KEY="sk_test_replace-with-test-secret"
PAYSTACK_PUBLIC_KEY="pk_test_replace-with-test-public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local preview sign-in only; both flags must be true. Keep disabled in production.
AUTH_DEMO_MODE="false"
NEXT_PUBLIC_AUTH_DEMO_MODE="false"
